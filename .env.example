# Copy to .env and fill in. Never commit .env.

# Token from https://discord.com/developers/applications (Bot > Reset Token)
DISCORD_TOKEN=

# Comma-separated Discord user IDs allowed to run code (required)
ALLOWED_USER_IDS=
# Optional: only allow runs in these chats (use /ids in the group chat to get its ID). Empty = any chat.
ALLOWED_CHANNEL_IDS=

# Internet for scripts: run `sudo bash sandbox/network-setup.sh --install` first, then set remotepy-net.
# "none" = no network at all.
SANDBOX_NETWORK=remotepy-net

# Interactive plots (Plotly, Altair, Bokeh): public URL of the pages service behind your
# reverse proxy, e.g. https://plots.example.com. Empty = send the .html files as attachments.
PAGES_URL=
PAGES_TTL_DAYS=7

# Sandbox limits
RUN_TIMEOUT=30
NOTEBOOK_TIMEOUT=120
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS=128
SANDBOX_TMPFS=128m
MAX_CONCURRENT=2

# Set to runsc after installing gVisor (see README) for much stronger isolation
SANDBOX_RUNTIME=
SANDBOX_IMAGE=remotepy-sandbox:latest
